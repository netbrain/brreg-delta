{
  "aktivitet": [
    "Skeivt kristent nettverk Kristiansand er en interesseforening for",
    "heterofile, homofile, bifile og transpersoner som har eller har hatt",
    "en tilknytning og tilhørighet til kristne frikirkelige menigheter og",
    "organisasjoner. Skeivt kristent nettverk Kristiansand skal jobbe for å",
    "fremme kunnskap og forståelse for et kristent syn som muliggjør",
    "kombinasjonen kristen tro og likekjønnet samliv, samt at transkjønnede",
    "og transpersoner kan leve i henhold til sin kjønnsidentitet eller",
    "kjønnsuttrykk."
  ],
