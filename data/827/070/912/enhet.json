  "aktivitet": [
    "Kursing/opplæring for befolkningen i Øst-Finnmark i samisk håndtverk",
    "for å bidra til at gamle tradisjoner videreføres, og gjennomfører",
    "hobbykvelder for medlemmene våre for å holde interessen oppe, samt",
    "kunne møtes og utveksle erfaringer innen håndtverk. Da både innen",
    "hardsløyd (laging av kniver, brosjer, knapper til samekoftebelter m.m.",
    "med reinhorn og materialer vi sanker i naturen og som vi bearberider),",
    "og innen håndarbeid (strikking, toving, bruk av sennagress, farging av",
    "garn, frynsing av sjal til kofter, veving av belter til samekofter",
    "m.m."
  ],
