  "vedtektsfestetFormaal": [
    "Maskinentreprenør for bygg og anlegg. Maskinentreprenør for oppdrag",
    "mot landbruk og utleige av maskiner og andre produkter/tjenester som",
    "naturlig hører til dette,herunder å delta i andre selskap med lignende",
