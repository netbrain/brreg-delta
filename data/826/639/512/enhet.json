  "aktivitet": [
    "Obiter Dictum er en frivillig studentorganisasjon som drives av",
    "studenter ved Fakultet for økonomi og samfunnsvitenskap ved Høgskolen",
    "i Innlandet, studiested Lillehammer. Organisasjonen har til formål å",
    "tilrettelegge for en lettere hverdag til studenter generelt, og",
    "jusstudenter spesielt. Formålet realiseres ved å tilby publisering av",
    "juridiske fagartikler, samfunnsrelaterte artikler, seminarer og",
    "skrivekurs, mv."
  ],
