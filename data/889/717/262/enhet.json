  "vedtektsfestetFormaal": [
    "Mekanisk verksted. Handel og agentur, import og eksport, salg av",
    "rådgivningstjenester, samt alt som står i forbindelse med dette,",
    "herunder deltagelse i andre selskaper med samme eller lignende formål.",
